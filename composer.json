{
    "name": "slothsoft/blob",
    "description": "Blob implementation of https://www.w3.org/TR/FileAPI/",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": ">=7.4",
        "slothsoft/core": "^1.15.0",
        "slothsoft/w3c": "^1.3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "~9.6.34"
    },
    "autoload": {
        "psr-4": {
            "Slothsoft\\Blob\\": "src"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "keywords": [
        "slothsoft",
        "docs"
    ],
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\Blob\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    },
    "homepage": "https://faulo.github.io/slothsoft-blob/",
    "config": {
        "platform": {
            "php": "7.4"
        }
    }
}
